# Alleen voor de lokale demo. Kopieer naar .env (make doet dat automatisch).
# De uitgeverssleutel, de agentsleutels en de wachtwoorden van de fictieve medewerkers worden bij
# de start gegenereerd in Docker-volumes en staan nergens in git. Er zijn geen API-sleutels nodig.

# Optioneel: een echt taalmodel in plaats van de deterministische planner.
# Zet PLANNER=llm en vul Azure OpenAI óf een OpenAI-compatibele endpoint in; draai dan make demo.
# PLANNER=llm
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_KEY=
# OPENAI_API_VERSION=
# OPENAI_BASE_URL=
# OPENAI_MODEL=
# OPENAI_API_KEY=
